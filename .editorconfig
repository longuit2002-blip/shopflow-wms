# EditorConfig: https://editorconfig.org
# Establishes baseline editor settings across the team and across CSharpier-formatted output.

root = true

# Defaults for every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Markdown preserves trailing whitespace (used for line breaks)
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# YAML, JSON, JS, TS, HTML/Razor — 2 spaces
[*.{yml,yaml,json,js,jsx,ts,tsx,html,cshtml,razor}]
indent_size = 2

# Shell scripts must be LF on every platform
[*.sh]
end_of_line = lf

# PowerShell scripts conventionally CRLF on Windows
[*.ps1]
end_of_line = crlf

# .NET source files
[*.{cs,csx,vb}]
indent_size = 4

# C# specific style and analyzer rules ----------------------------------------

[*.cs]
# Use spaces around binary operators
csharp_space_around_binary_operators = before_and_after

# Prefer file-scoped namespaces (matches CSharpier output)
csharp_style_namespace_declarations = file_scoped:warning

# var preferences (CSharpier doesn't enforce; this is review-time signal)
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_elsewhere = true:suggestion

# Modern language features
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_top_level_statements = false:suggestion
csharp_style_prefer_primary_constructors = true:suggestion

# Expression-bodied members
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_style_expression_bodied_accessors = when_on_single_line:suggestion

# Pattern matching
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion

# ShopFlow analyzer rules — Warning at MVP per ADR/U5; promoted to Error in U11.
# See AGENTS.md sections 3, 5, 6 for the rule rationale.
dotnet_diagnostic.ShopFlow0001.severity = warning   # No raw DbSet<T> queries
dotnet_diagnostic.ShopFlow0002.severity = warning   # Missing correlation context propagation
dotnet_diagnostic.ShopFlow0003.severity = warning   # Webhook handler missing [Idempotent] attribute
dotnet_diagnostic.ShopFlow0004.severity = warning   # DateTime.Now / DateTimeOffset.Now forbidden

# Microsoft analyzer rules — opinionated baseline
dotnet_diagnostic.CA1822.severity = suggestion       # Mark members as static
dotnet_diagnostic.CA2007.severity = none             # ConfigureAwait — handled by ASP.NET context
dotnet_diagnostic.IDE0290.severity = suggestion      # Use primary constructor
