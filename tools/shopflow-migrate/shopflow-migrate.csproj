<Project Sdk="Microsoft.NET.Sdk">

  <!--
    shopflow-migrate per-tenant migration runner CLI per plan U6.

    Subcommands:
      provision  catalog         create plus migrate shopflow_control
      provision  tenant=slug     create plus migrate one tenant DB (idempotent)
      apply  target=v [concurrency=N]   parallel-by-tenant migration apply
      archive  tenant=slug       status flip plus GRANT revoke (sync); DROP deferred
      restore  tenant=slug       reverse archive while within retention window
      status                     per-tenant migration state summary

    Hand-rolled arg parser (no System.CommandLine dep) per shopflow-gate
    precedent the surface is small enough that a 60 line parser beats a
    package version bump.

    References the control-plane Infrastructure plus Migrations projects so the
    catalog DbContext plus initial catalog migration are available; per-module
    DbContexts are registered into ModuleMigrationRegistry at composition time
    (U6 ships with control-plane only; U8 adds Inventory).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ShopFlow.Migrate</RootNamespace>
    <AssemblyName>shopflow-migrate</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ControlPlane\ShopFlow.ControlPlane.Infrastructure\ShopFlow.ControlPlane.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\ControlPlane\ShopFlow.ControlPlane.Migrations\ShopFlow.ControlPlane.Migrations.csproj" />
    <ProjectReference Include="..\..\src\Services\Inventory\ShopFlow.Inventory.Infrastructure\ShopFlow.Inventory.Infrastructure.csproj" />
    <!-- Sprint-8 U10 — pulls in AuthDbContext (for the AddUsers migration)
         + Argon2idPasswordHasher + PasswordGenerator so the owner-seed
         path doesn't duplicate the hashing implementation (SG-001 / ADV-010). -->
    <ProjectReference Include="..\..\src\Services\Auth\ShopFlow.Auth.Infrastructure\ShopFlow.Auth.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShopFlow.Migrate.UnitTests" />
  </ItemGroup>

</Project>
