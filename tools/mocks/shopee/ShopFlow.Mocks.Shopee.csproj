<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Shopee mock server — Sprint-4 plan U7. Standalone Kestrel-hosted
    ASP.NET service that emulates Shopee's webhook-source behaviour:
    HMAC-SHA256-signed outgoing webhooks, advertised rate-limit headers,
    chaos-injection endpoint for 429/500 testing. Aspire (dev) and
    docker-compose (prod-parity dev runs) start it as a sibling resource
    to Channel.Api.

    Per Channel AGENTS.md §11.6, marketplace mocks live as separate
    processes (not in-process) so integration tests exercise real HTTP +
    HMAC over the wire — the Sprint-3 in-process MockShippingProvider
    pattern is for adapter unit tests, NOT receiver integration.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ShopFlow.Mocks.Shopee</RootNamespace>
  </PropertyGroup>

  <!--
    No project references — the mock matches Shopee's wire format
    independently. Sharing the ShopeeSigner with ShopFlow.Channel.Infrastructure
    is intentional via a small literal duplication: the mock is supposed
    to look like a third-party server, so re-importing our code would let
    drift between mock + production go undetected. The signer is 8 lines.
  -->

</Project>
