#!/usr/bin/env sh
# ShopFlow WMS pre-commit hook (Husky.NET)
#
# Wired by `dotnet husky install` (run via `task setup`). Do not edit the
# generated _/husky.sh — edit this file to change pre-commit behavior.

. "$(dirname "$0")/_/husky.sh"

# Run CSharpier in check mode against staged files. Fails the commit if any
# .cs file is unformatted; run `task format` to fix.
dotnet csharpier check .
