<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ShopFlow.Outbound.UnitTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Sprint-3-redux U5 — InMemory EF Core provider for unit-testing
      PickWaveGeneratorService's window-close logic without spinning a
      Postgres container. The wave generator's per-tenant DbContext
      resolution is exercised end-to-end against in-memory databases.
      Integration tests (tests/ShopFlow.Outbound.IntegrationTests) cover
      the real Postgres round-trip.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <!-- Sprint-4 U8 — NSubstitute for OrderImportedConsumer test doubles. -->
    <PackageReference Include="NSubstitute" />
    <!-- Sprint-8.5 U7 — FakeTimeProvider for SagaTransitionObserverTests
         deterministic timestamp control. See
         docs/solutions/2026-05-20-microsoft-extensions-timeprovider-testing-cpm.md. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Services\Outbound\ShopFlow.Outbound.Domain\ShopFlow.Outbound.Domain.csproj" />
    <ProjectReference Include="..\..\src\Services\Outbound\ShopFlow.Outbound.Application\ShopFlow.Outbound.Application.csproj" />
    <ProjectReference Include="..\..\src\Services\Outbound\ShopFlow.Outbound.Infrastructure\ShopFlow.Outbound.Infrastructure.csproj" />
  </ItemGroup>

</Project>
