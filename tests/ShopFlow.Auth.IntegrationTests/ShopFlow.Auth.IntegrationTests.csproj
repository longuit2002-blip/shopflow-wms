<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration test harness for the Auth module against real Postgres
    via Testcontainers (Sprint-8 U3). Two suites:
      • UserRepositoryTests           — case-insensitive email match,
        UNIQUE-23505 → EmailInUse, paged list ordering.
      • AddUsersMigrationSmokeTests   — pg_indexes shows
        ux_users_email_lower; pg_constraint shows chk_users_role with
        the expected expression body; ix_users_role_active present.
    Both tagged Category=Integration per AGENTS.md §8.61. The Redis-
    backed integration tests for IRefreshTokenStore land in U5.
  -->

  <PropertyGroup>
    <RootNamespace>ShopFlow.Auth.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shared\ShopFlow.SharedKernel\ShopFlow.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\Services\Auth\ShopFlow.Auth.Domain\ShopFlow.Auth.Domain.csproj" />
    <ProjectReference Include="..\..\src\Services\Auth\ShopFlow.Auth.Application\ShopFlow.Auth.Application.csproj" />
    <ProjectReference Include="..\..\src\Services\Auth\ShopFlow.Auth.Infrastructure\ShopFlow.Auth.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Services\Auth\ShopFlow.Auth.Api\ShopFlow.Auth.Api.csproj" />
    <!-- Finish-line U5 — the MultiTenantAuthFixture provisions a control-plane
         catalog + registers tenant-a/tenant-b so the WAF's
         TenantRoutingMiddleware resolves them. ControlPlane.Migrations must be
         on the probing path for ControlPlaneDbContext.MigrateAsync (same reason
         HandoffFixture + StockSync.IntegrationTests reference it). -->
    <ProjectReference Include="..\..\src\ControlPlane\ShopFlow.ControlPlane.Infrastructure\ShopFlow.ControlPlane.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\ControlPlane\ShopFlow.ControlPlane.Migrations\ShopFlow.ControlPlane.Migrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Finish-line U1 — shared proof-run gate (env/CI opt-in) for
         CrossTenant403Test + the AuthCrossTenant harness (U5). Linked
         single-source. -->
    <Compile Include="..\_shared\ProofGate.cs">
      <Link>_shared\ProofGate.cs</Link>
    </Compile>
    <!-- Finish-line U5 — RolePermissionsSeed linked from tools/shopflow-migrate/
         so MultiTenantAuthFixture seeds each tenant's role_permissions with the
         canonical baselines (and AuthCrossTenantTests can diff against
         RolePermissionsSeed.PickerBaseline). Cross-project ProjectReference to
         the migrate tool would pull its Program entrypoint (OutputType=Exe) and
         collide with Auth.Api's Program WAF target — same trap Sprint-10.5 U4 /
         Sprint-12 U4 documented. The Compile-link keeps a single source of
         truth without the transitive cost. -->
    <Compile Include="..\..\tools\shopflow-migrate\Provisioning\RolePermissionsSeed.cs">
      <Link>Provisioning\RolePermissionsSeed.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
