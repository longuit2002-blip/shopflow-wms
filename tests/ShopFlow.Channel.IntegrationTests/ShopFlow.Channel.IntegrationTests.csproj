<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sprint-4 plan U9 — Channel module integration test harness. Runs in CI
    against Testcontainers Postgres + an in-process Kestrel-hosted
    Channel.Api via WebApplicationFactory. Two suite shapes:

      • MultiTenantWebhookScaleGateTests (Category=Load): 5 tenants × 200
        webhooks/s × 5s burst; p99 < 200ms; fairness ≥ 0.85; 100-replay
        idempotency. Wall-time measurement deferred to nightly CI per
        Sprint-1/3 precedent (Docker daemon not running on this dev
        machine).

      • WebhookReceiverIntegrationTests (Category=Integration): single-
        tenant webhook -> receiver -> webhook_events insert + outbox row
        round-trip. Replay returns isDuplicate=true with NO second outbox.
        Cross-tenant signature mismatch -> 401.

    Both share the PostgresFixture / TenantHarness shape from
    Outbound/Inventory integration tests. Sprint-4 ships the project skel
    + the scale-gate skeleton; the harness body is deferred to a
    follow-up (sign-off documents).
  -->

  <PropertyGroup>
    <RootNamespace>ShopFlow.Channel.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shared\ShopFlow.SharedKernel\ShopFlow.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\ControlPlane\ShopFlow.ControlPlane.Infrastructure\ShopFlow.ControlPlane.Infrastructure.csproj" />
    <!--
      Finish-line U7 — the harness applies control-plane migrations
      reflectively via MigrationsAssembly("ShopFlow.ControlPlane.Migrations"),
      so the migrations assembly must land in the test output dir. Without
      this reference the Docker-backed receive tests throw
      FileNotFoundException at TenantWebhookHarness.ApplyControlPlaneMigrationsAsync
      (a never-run composition gap surfaced when these facts first executed).
    -->
    <ProjectReference Include="..\..\src\ControlPlane\ShopFlow.ControlPlane.Migrations\ShopFlow.ControlPlane.Migrations.csproj" />
    <ProjectReference Include="..\..\src\Services\Channel\ShopFlow.Channel.Api\ShopFlow.Channel.Api.csproj" />
    <ProjectReference Include="..\..\src\Services\Channel\ShopFlow.Channel.Infrastructure\ShopFlow.Channel.Infrastructure.csproj" />
    <!-- Sprint-5 U6 — round-trip test boots the Shopee mock in-process via WebApplicationFactory<Program>. -->
    <ProjectReference Include="..\..\tools\mocks\shopee\ShopFlow.Mocks.Shopee.csproj" />
    <!-- Finish-line U7 — round-trip test boots the Lazada mock in-process via WebApplicationFactory<MockEntryPoint>. -->
    <ProjectReference Include="..\..\tools\mocks\lazada\ShopFlow.Mocks.Lazada.csproj" />
  </ItemGroup>

</Project>
