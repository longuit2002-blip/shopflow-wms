<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration test harness for the Outbound module (Sprint-3-redux U2).
    Uses Testcontainers Postgres + per-test tenant DB provisioning,
    mirroring the Inbound.IntegrationTests pattern.
  -->

  <PropertyGroup>
    <RootNamespace>ShopFlow.Outbound.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- Sprint-7 U6 — NSubstitute for the SagaTransitionsEndToEndSignalRTests
         mock IHubContext + ITenantCatalog (real SignalR transport would
         require booting WebApplicationFactory<Program>). -->
    <PackageReference Include="NSubstitute" />
    <!-- Sprint-8.5 U10 — ILoggingBuilder.AddProvider lives in
         Microsoft.Extensions.Logging core (not Logging.Configuration);
         the BuildHarness fixtures want explicit NullLoggerProvider.Instance
         to silence test logging. Explicit pin preserves the test-author
         intent without re-deriving the dependency. -->
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <!-- Sprint-10.5 U4 — WebApplicationFactory<Program> for the 403
         wire-shape integration suite under Authorization/. Outbound
         already booted WAF in Sprint-7 endpoint tests; this entry pins
         the explicit package floor. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shared\ShopFlow.SharedKernel\ShopFlow.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\Services\Outbound\ShopFlow.Outbound.Domain\ShopFlow.Outbound.Domain.csproj" />
    <ProjectReference Include="..\..\src\Services\Outbound\ShopFlow.Outbound.Application\ShopFlow.Outbound.Application.csproj" />
    <ProjectReference Include="..\..\src\Services\Outbound\ShopFlow.Outbound.Infrastructure\ShopFlow.Outbound.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Services\Outbound\ShopFlow.Outbound.Api\ShopFlow.Outbound.Api.csproj" />
    <!--
      U9 cross-module flow test exercises the real Inventory consumers
      against a single shared-tenant Postgres DB. Sprint-2.5's outbox
      table-name prefix unlocked this — both modules' migrations apply
      cleanly to one DB.
    -->
    <ProjectReference Include="..\..\src\Services\Inventory\ShopFlow.Inventory.Domain\ShopFlow.Inventory.Domain.csproj" />
    <ProjectReference Include="..\..\src\Services\Inventory\ShopFlow.Inventory.Application\ShopFlow.Inventory.Application.csproj" />
    <ProjectReference Include="..\..\src\Services\Inventory\ShopFlow.Inventory.Infrastructure\ShopFlow.Inventory.Infrastructure.csproj" />
    <!-- Sprint-10.5 U4 — NarrowedJwtBuilder is linked as a Compile item
         from Auth.IntegrationTests/Authorization/. Cross-test-project
         ProjectReference (the plan's prescribed shape) pulls Auth.Api.dll
         transitively and collides with this project's WAF target
         (Outbound.Api Program). Linked-file keeps the helper single-
         sourced without the transitive cost. -->
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\ShopFlow.Auth.IntegrationTests\Authorization\NarrowedJwtBuilder.cs">
      <Link>Authorization\NarrowedJwtBuilder.cs</Link>
    </Compile>
    <!-- Sprint-12 U4 — RolePermissionsSeed is linked from tools/shopflow-migrate/
         so HandoffFixture's BuildPickerJwt / BuildDispatcherJwt can pin the
         JWT perm[] against the canonical PickerBaseline + DispatcherBaseline
         constants directly. Cross-project ProjectReference to the migrate
         tool would pull its Program entrypoint (OutputType=Exe) and collide
         with this project's Outbound.Api Program WAF target — same trap
         Sprint-10.5 U4 documented for Auth.Api. The Compile-link keeps a
         single source of truth without the transitive cost. -->
    <Compile Include="..\..\tools\shopflow-migrate\Provisioning\RolePermissionsSeed.cs">
      <Link>Provisioning\RolePermissionsSeed.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
