<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ShopFlow.SharedKernel.UnitTests — unit tests for the kernel:
      Domain/         Result<T>, BaseEntity (domain event buffer), ValueObject
      Infrastructure/ TenancyInterceptor, OutboxInterceptor (EF Core SQLite in-memory)
      Analyzers/      ShopFlow0001-0004 via Microsoft.CodeAnalysis.Testing harness

    Postgres-backed verification for these interceptors lives in
    ShopFlow.Inventory.IntegrationTests via Testcontainers — here we stay
    fast-loop with SQLite :memory:.

    Inherits all base settings + test conventions from:
      • Directory.Build.props  (root: target framework, nullable, etc.)
      • tests/Directory.Build.props (test packages, IsTestProject, NU1701 NoWarn,
        Xunit + FluentAssertions implicit usings)
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.XUnit" />
    <!--
      The Analyzer.Testing package's transitive deps lock MS.CodeAnalysis at
      1.0.x. The analyzer DLL under test is built on MS.CodeAnalysis 4.11.0;
      without these explicit pins NuGet resolves the lowest common version
      and the analyzer DLL fails to load (CS1705). See
      docs/solutions/2026-04-28-analyzer-testing-transitives.md.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Reference the analyzer assembly directly (NOT as Analyzer): the testing
      framework loads the analyzer type via reflection. Runtime kernel still
      bundles the analyzer with OutputItemType="Analyzer" for consumers.
    -->
    <ProjectReference Include="..\..\src\Shared\ShopFlow.SharedKernel\ShopFlow.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\Shared\ShopFlow.SharedKernel.Analyzers\ShopFlow.SharedKernel.Analyzers.csproj" />
  </ItemGroup>

</Project>
