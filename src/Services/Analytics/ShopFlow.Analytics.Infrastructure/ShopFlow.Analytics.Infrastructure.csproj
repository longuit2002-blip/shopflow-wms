<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ShopFlow.Analytics.Infrastructure — EF Core DbContext for the analytics
    read-model + integration-event consumers that project into it. EF Core +
    Npgsql come transitively from SharedKernel; only the design-time
    package is module-local.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShopFlow.Analytics.Application\ShopFlow.Analytics.Application.csproj" />
    <ProjectReference Include="..\..\..\Shared\ShopFlow.SharedKernel\ShopFlow.SharedKernel.csproj" />
  </ItemGroup>

</Project>
