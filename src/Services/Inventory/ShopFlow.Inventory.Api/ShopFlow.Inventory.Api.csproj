<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    ShopFlow.Inventory.Api — HTTP surface for the Inventory module (plan
    U8). Ships skeleton Program.cs + a single controller that returns 501
    Not Implemented; the real reservation/availability endpoints land in
    Sprint-1-redux (plan 003). The Api project is the only entry that
    references SharedKernel.Infrastructure and the module's
    Infrastructure project, per the canonical layering arrow in
    AGENTS.md §11.78.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ShopFlow.Inventory.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShopFlow.Inventory.Application\ShopFlow.Inventory.Application.csproj" />
    <ProjectReference Include="..\ShopFlow.Inventory.Infrastructure\ShopFlow.Inventory.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\Shared\ShopFlow.SharedKernel\ShopFlow.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sprint-6 U4 — JwtBearer authentication for Owner role calls from the frontend. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

</Project>
