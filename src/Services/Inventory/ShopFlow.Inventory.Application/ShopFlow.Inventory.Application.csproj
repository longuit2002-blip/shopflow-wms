<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ShopFlow.Inventory.Application
    ==============================
    Use-case orchestration for the Inventory bounded context: MediatR
    commands/queries/handlers, DTOs, and the repository port interfaces
    that Infrastructure implements (per AGENTS.md §7.46). No EF, no
    ASP.NET, no MassTransit transport here — only the contracts.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShopFlow.Inventory.Domain\ShopFlow.Inventory.Domain.csproj" />
    <ProjectReference Include="..\..\..\Shared\ShopFlow.SharedKernel\ShopFlow.SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\Shared\ShopFlow.Contracts\ShopFlow.Contracts.csproj" />
  </ItemGroup>

</Project>
