{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ControlPlane": {
    "ConnectionString": "Host=localhost;Port=6432;Database=shopflow_control;Username=shopflow_app;Password=shopflow_app_dev_only",
    "TenantTemplate": "Host=localhost;Port=6432;Database={db};Username=shopflow_app;Password=shopflow_app_dev_only"
  },
  "MessageBus": {
    "Transport": "RabbitMq",
    "ConnectionString": "amqp://guest:guest@localhost:5672"
  },
  "Notification": {
    "Mailer": {
      "Provider": "Logging",
      "MailKitSmtp": {
        "Host": "localhost",
        "Port": 25,
        "Username": "",
        "Password": "",
        "FromEmail": "noreply@shopflow.local",
        "FromDisplayName": "ShopFlow WMS",
        "UseStartTls": false
      }
    },
    "Dispatcher": {
      "PollIntervalSeconds": 5,
      "BatchSize": 50,
      "MaxAttempts": 3
    }
  }
}
