{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "ShopFlow.Notification": "Debug"
    }
  },
  "Notification": {
    "Mailer": {
      "Provider": "MailKitSmtp",
      "MailKitSmtp": {
        "Host": "mailpit",
        "Port": 1025,
        "Username": "",
        "Password": "",
        "FromEmail": "noreply@shopflow.dev",
        "FromDisplayName": "ShopFlow WMS (dev)",
        "UseStartTls": false
      }
    },
    "Dispatcher": {
      "PollIntervalSeconds": 3,
      "BatchSize": 25,
      "MaxAttempts": 3
    }
  }
}
