{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "_README": "ReverseProxy.Routes are matched first-to-last; each route forwards to one ClusterId. ClusterId destinations are placeholders for the modular-monolith stage (the gateway and module APIs live in one container under Aspire). At W6 mechanical split the Address values flip to split-host URLs. Tenant context — X-ShopFlow-Tenant header, JWT — is forwarded by YARP defaults; the downstream module's TenantRoutingMiddleware extracts it.",
  "ReverseProxy": {
    "Routes": {
      "inventory": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/inventory/{**catch-all}" }
      },
      "inbound": {
        "ClusterId": "inbound",
        "Match": { "Path": "/api/inbound/{**catch-all}" }
      },
      "outbound": {
        "ClusterId": "outbound",
        "Match": { "Path": "/api/outbound/{**catch-all}" }
      },
      "channel": {
        "ClusterId": "channel",
        "Match": { "Path": "/api/channel/{**catch-all}" }
      },
      "analytics": {
        "ClusterId": "analytics",
        "Match": { "Path": "/api/analytics/{**catch-all}" }
      }
    },
    "Clusters": {
      "inventory": {
        "Destinations": { "primary": { "Address": "http://inventory:8080" } }
      },
      "inbound": {
        "Destinations": { "primary": { "Address": "http://inbound:8080" } }
      },
      "outbound": {
        "Destinations": { "primary": { "Address": "http://outbound:8080" } }
      },
      "channel": {
        "Destinations": { "primary": { "Address": "http://channel:8080" } }
      },
      "analytics": {
        "Destinations": { "primary": { "Address": "http://analytics:8080" } }
      }
    }
  }
}
