{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "_README": "ReverseProxy.Routes are matched first-to-last; each route forwards to one ClusterId. ClusterId destinations are placeholders for the modular-monolith stage (the gateway and module APIs live in one container under Aspire). At W6 mechanical split the Address values flip to split-host URLs. Tenant context — X-ShopFlow-Tenant header, JWT — is forwarded by YARP defaults; the downstream module's TenantRoutingMiddleware extracts it. Sprint-7 U5 — /hub routes to the Outbound cluster (single-hub-host decision per doc-review): YARP forwards the WebSocket upgrade automatically; the SignalR JS client falls back to long-polling on the same path when WS is blocked.",
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "inventory": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/inventory/{**catch-all}" }
      },
      "inventory-v1": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/v1/inventory/{**catch-all}" }
      },
      "inbound": {
        "ClusterId": "inbound",
        "Match": { "Path": "/api/inbound/{**catch-all}" }
      },
      "outbound": {
        "ClusterId": "outbound",
        "Match": { "Path": "/api/outbound/{**catch-all}" }
      },
      "channel": {
        "ClusterId": "channel",
        "Match": { "Path": "/api/channel/{**catch-all}" }
      },
      "analytics": {
        "ClusterId": "analytics",
        "Match": { "Path": "/api/analytics/{**catch-all}" }
      },
      "stocksync-sync": {
        "ClusterId": "stocksync",
        "Match": { "Path": "/api/sync/{**catch-all}" }
      },
      "stocksync-skus": {
        "ClusterId": "stocksync",
        "Match": { "Path": "/api/skus/{**catch-all}" }
      },
      "hub": {
        "ClusterId": "outbound",
        "Match": { "Path": "/hub/{**catch-all}" }
      },
      "hub-root": {
        "ClusterId": "outbound",
        "Match": { "Path": "/hub" }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": { "primary": { "Address": "http://auth-api:8080" } }
      },
      "inventory": {
        "Destinations": { "primary": { "Address": "http://inventory:8080" } }
      },
      "inbound": {
        "Destinations": { "primary": { "Address": "http://inbound:8080" } }
      },
      "outbound": {
        "Destinations": { "primary": { "Address": "http://outbound:8080" } }
      },
      "channel": {
        "Destinations": { "primary": { "Address": "http://channel:8080" } }
      },
      "analytics": {
        "Destinations": { "primary": { "Address": "http://analytics:8080" } }
      },
      "stocksync": {
        "Destinations": { "primary": { "Address": "http://stocksync-api:8080" } }
      }
    }
  }
}
