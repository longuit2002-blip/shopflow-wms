{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Authority": "",
    "Audience": "shopflow-gateway",
    "RequireHttpsMetadata": false,
    "DevelopmentSigningKey": "dev-only-symmetric-signing-key-please-rotate-32b"
  },
  "ReverseProxy": {
    "Routes": {
      "inventory": {
        "ClusterId": "inventory-api",
        "Match": { "Path": "/api/inventory/{**catch-all}" }
      },
      "inbound": {
        "ClusterId": "inbound-api",
        "Match": { "Path": "/api/inbound/{**catch-all}" }
      },
      "outbound": {
        "ClusterId": "outbound-api",
        "Match": { "Path": "/api/outbound/{**catch-all}" }
      },
      "channel": {
        "ClusterId": "channel-api",
        "Match": { "Path": "/api/channel/{**catch-all}" }
      },
      "analytics": {
        "ClusterId": "analytics-api",
        "Match": { "Path": "/api/analytics/{**catch-all}" }
      }
    },
    "Clusters": {
      "inventory-api": {
        "Destinations": {
          "primary": { "Address": "http://inventory-api" }
        }
      },
      "inbound-api": {
        "Destinations": {
          "primary": { "Address": "http://inbound-api" }
        }
      },
      "outbound-api": {
        "Destinations": {
          "primary": { "Address": "http://outbound-api" }
        }
      },
      "channel-api": {
        "Destinations": {
          "primary": { "Address": "http://channel-api" }
        }
      },
      "analytics-api": {
        "Destinations": {
          "primary": { "Address": "http://analytics-api" }
        }
      }
    }
  }
}
