# Default: let Git auto-detect text vs binary and normalize line endings to LF in the repo.
* text=auto

# Shell scripts must keep LF on every platform — CRLF breaks `#!/usr/bin/env bash` on Linux/macOS.
*.sh text eol=lf

# Husky.NET hook scripts have no extension but are shell scripts — same rule.
.husky/pre-commit text eol=lf
.husky/post-commit text eol=lf
.husky/pre-push text eol=lf
.husky/commit-msg text eol=lf

# PowerShell scripts conventionally use CRLF on Windows; harmless on PS Core too.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# C# source — explicit LF to match .editorconfig (end_of_line = lf) and the
# CSharpier pre-commit hook, which formats with LF and rejects CRLF. Without
# this pin, `* text=auto` + core.autocrlf=true check these out as CRLF on
# Windows, so `csharpier --check` fails on ~500 files and blocks every commit.
# (The cross-machine zip workflow also re-introduced mixed endings here.)
*.cs     text eol=lf
*.csx    text eol=lf

# Frontend source — explicit LF (Sprint-6 introduces TypeScript / Vite stack).
# Closes Sprint-5 methodology writeup friction mode 6 for the file types
# this sprint creates.
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.mjs    text eol=lf
*.cjs    text eol=lf
*.json   text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.svg    text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.md     text eol=lf

# Lockfiles — committed but not auto-merged.
pnpm-lock.yaml    text eol=lf -diff
package-lock.json text eol=lf -diff
yarn.lock         text eol=lf -diff

# Binary assets — never normalize.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.pdf    binary
*.zip    binary
*.gz     binary

# Word documents are binary — never try to merge or normalize them.
*.docx binary
